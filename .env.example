# Copiar a .env y ajustar según el entorno.

# Motor de base de datos: el backend soporta PostgreSQL/PostGIS (default, usado en
# este docker-compose) y SQL Server (para IMTES, sin Docker en su servidor Windows —
# ver database/migrations-mssql/ y DEPLOY.md). Cambiar de motor NUNCA requiere
# recompilar, solo estas variables:
#   SPRING_DATASOURCE_URL         jdbc:postgresql://host:5432/db  o
#                                  jdbc:sqlserver://host:1433;databaseName=db;encrypt=true
#   GTFSPLATFORM_HIBERNATE_DIALECT  org.hibernate.dialect.PostgreSQLDialect (default)  o
#                                    org.hibernate.dialect.SQLServerDialect
#   GTFSPLATFORM_FLYWAY_LOCATIONS  database/migrations (default) o
#                                   database/migrations-mssql
# Este docker-compose.yml usa Postgres; los tres valores de arriba solo hace falta
# tocarlos para desplegar contra SQL Server (ver .env.production.example).
POSTGRES_DB=gtfsplatform
POSTGRES_USER=gtfsplatform
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=5173

# MapTileProvider: en dev, tiles OSM estándar (atribución obligatoria en el mapa).
# En producción, apuntar a un proveedor comercial o tiles propios.
GTFSPLATFORM_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# RoutingProvider: cómo se traza el recorrido al unir paradas por la red vial
# (sección 9 del prompt), igual que Conveyal lo hace con su propio motor R5.
#   "osrm"   (por defecto) - demo público de OSRM (router.project-osrm.org).
#     Probado con 15 pares de puntos reales en Hermosillo: 15/15 éxito, ~0.9s
#     promedio. Es un servicio de demostración sin SLA — para producción,
#     hospeda tu propio OSRM con el extracto OSM de tu región y cambia
#     GTFSPLATFORM_OSRM_URL.
#   "manual" - sin ruteo, conecta las paradas con líneas rectas (el usuario
#     dibuja/ajusta a mano desde ahí).
GTFSPLATFORM_ROUTING_PROVIDER=osrm
GTFSPLATFORM_OSRM_URL=https://router.project-osrm.org

# GeocodingProvider: sugiere nombre de parada por intersección más cercana al crearla
# (ej. "Calle Rosales & Avenida Doctor Paliza"). Tres opciones:
#   "esri"     (por defecto) - mismo mecanismo que usa el editor de Conveyal
#     (datatools-ui): ArcGIS World Geocoding Service con returnIntersection=true.
#     Probado con 100 puntos reales en Hermosillo: 76% con sugerencia, ~0.5s
#     promedio, 0 errores. No requiere API key para uso básico (20,000
#     consultas/mes gratis); GTFSPLATFORM_ESRI_API_KEY es opcional (token propio
#     para más cuota). Es un servicio propietario de un tercero.
#   "overpass" - datos 100% abiertos OSM vía API pública de Overpass. Mismo test
#     de 100 puntos: 0% de éxito, timeouts de ~19s — son espejos comunitarios
#     gratuitos sin SLA, la confiabilidad varía mucho según el momento.
#   "none"     - sin sugerencia, el usuario siempre escribe el nombre a mano.
GTFSPLATFORM_GEOCODING_PROVIDER=esri
GTFSPLATFORM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GTFSPLATFORM_GEOCODING_RADIUS_M=35
GTFSPLATFORM_ESRI_API_KEY=

# Autenticación: cada usuario se registra (email + contraseña) y solo ve/administra
# los feeds que él mismo creó. GTFSPLATFORM_JWT_SECRET firma los tokens de sesión —
# en producción usar un valor propio de al menos 32 caracteres aleatorios; el
# default aquí es solo para desarrollo local.
GTFSPLATFORM_JWT_SECRET=dev-only-secret-change-me-1234567890-abcdefghijklmnopqrstuvwxyz
GTFSPLATFORM_JWT_EXPIRATION_HOURS=168

VITE_API_BASE_URL=http://localhost:8080/api/v1
