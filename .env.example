# Copiar a .env y ajustar según el entorno.

POSTGRES_DB=gtfsplatform
POSTGRES_USER=gtfsplatform
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=5173

# MapTileProvider: en dev, tiles OSM estándar (atribución obligatoria en el mapa).
# En producción, apuntar a un proveedor comercial o tiles propios.
GTFSPLATFORM_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# RoutingProvider: "manual" (por defecto, sin dependencia externa) u "osrm".
GTFSPLATFORM_ROUTING_PROVIDER=manual
GTFSPLATFORM_OSRM_URL=

# GeocodingProvider: sugiere nombre de parada por intersección más cercana al crearla
# (ej. "Calle Rosales & Avenida Doctor Paliza"). Tres opciones:
#   "overpass" (por defecto) - datos abiertos OSM vía API pública de Overpass;
#     confiabilidad variable (son espejos comunitarios gratuitos sin SLA).
#   "esri"     - mismo mecanismo que usa el editor de Conveyal (datatools-ui):
#     ArcGIS World Geocoding Service con returnIntersection=true. Más confiable
#     (servicio comercial con SLA), no requiere API key para uso básico, pero es
#     un servicio propietario de un tercero. GTFSPLATFORM_ESRI_API_KEY es opcional
#     (token propio para más cuota en producción).
#   "none"     - sin sugerencia, el usuario siempre escribe el nombre a mano.
GTFSPLATFORM_GEOCODING_PROVIDER=overpass
GTFSPLATFORM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GTFSPLATFORM_GEOCODING_RADIUS_M=35
GTFSPLATFORM_ESRI_API_KEY=

VITE_API_BASE_URL=http://localhost:8080/api/v1
