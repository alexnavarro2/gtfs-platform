# Copiar a .env en el servidor (NUNCA subir el .env real a git) y ajustar.
# Usar junto con docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Dominio público de la app (sin https://, sin barra al final). Antes de levantar
# los contenedores, el DNS de este dominio ya debe apuntar (registro A) a la IP
# pública de esta VM — si no, Caddy no podrá obtener el certificado HTTPS.
APP_DOMAIN=alexnavarromx.com

POSTGRES_DB=gtfsplatform
POSTGRES_USER=gtfsplatform
# Genera una contraseña real, no dejes esta:
#   openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIA_ESTO

# Firma los tokens de sesión — un valor robado permite falsificar sesiones de
# cualquier usuario. Genera uno propio, no reutilices el de desarrollo local:
#   openssl rand -base64 48
GTFSPLATFORM_JWT_SECRET=CAMBIA_ESTO
GTFSPLATFORM_JWT_EXPIRATION_HOURS=168

# Mapas, ruteo y geocoding — mismos defaults que en desarrollo. El demo público de
# OSRM y el geocoding de Esri son servicios gratuitos de terceros sin SLA; si el
# piloto crece o el ruteo/geocoding empieza a fallar seguido, hospeda tu propio
# OSRM con el extracto OSM de tu región y cambia GTFSPLATFORM_OSRM_URL.
GTFSPLATFORM_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GTFSPLATFORM_ROUTING_PROVIDER=osrm
GTFSPLATFORM_OSRM_URL=https://router.project-osrm.org
GTFSPLATFORM_GEOCODING_PROVIDER=esri
GTFSPLATFORM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GTFSPLATFORM_GEOCODING_RADIUS_M=35
GTFSPLATFORM_ESRI_API_KEY=
