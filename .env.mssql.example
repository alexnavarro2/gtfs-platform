# Variables reales para correr el backend contra SQL Server, sin Docker, en el
# servidor Windows de IMTES (java -jar app.jar, típicamente como Windows Service).
# Ver DEPLOY.md para el resto del despliegue (IIS como reverse proxy, ruta
# /gtfs bajo el dominio existente, etc.) — esto solo cubre las variables de
# entorno del backend.

# Cadena de conexión JDBC a SQL Server. Cambiar HOST/PUERTO/NOMBRE_DB según el
# servidor real; encrypt=true;trustServerCertificate=true es necesario salvo que
# el SQL Server tenga un certificado TLS confiable instalado.
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=gtfsplatform;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=gtfsplatform_app
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTO

# Estos dos son los que activan el modo SQL Server — sin ellos, el backend
# arranca contra Postgres por default.
GTFSPLATFORM_HIBERNATE_DIALECT=org.hibernate.dialect.SQLServerDialect
# Ruta absoluta a database/migrations-mssql en el servidor (dónde sea que se
# copie el código) — NO database/migrations (esa carpeta es para Postgres).
GTFSPLATFORM_FLYWAY_LOCATIONS=filesystem:C:/gtfs-platform/database/migrations-mssql

# Igual que en .env.production.example — genera valores propios, no uses estos:
#   openssl rand -base64 24   (contraseña, si no la generó el DBA)
#   openssl rand -base64 48   (JWT secret)
GTFSPLATFORM_JWT_SECRET=CAMBIA_ESTO
GTFSPLATFORM_JWT_EXPIRATION_HOURS=168

# Mismos servicios externos que en cualquier otro despliegue — ver el comentario
# correspondiente en .env.example para el detalle de cada uno.
GTFSPLATFORM_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GTFSPLATFORM_ROUTING_PROVIDER=osrm
GTFSPLATFORM_OSRM_URL=https://router.project-osrm.org
GTFSPLATFORM_GEOCODING_PROVIDER=esri
GTFSPLATFORM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GTFSPLATFORM_GEOCODING_RADIUS_M=35
GTFSPLATFORM_ESRI_API_KEY=

# Puerto donde escucha el proceso java -jar (IIS hace de reverse proxy hacia
# este puerto, no lo expone directo a internet).
SERVER_PORT=8080

# Ruta pública final si se monta como imtes.sonora.gob.mx/gtfs (ajustar el nombre
# del proyecto si es otro) — hace falta en el FRONTEND, no en el backend: se pasa
# como build arg VITE_API_BASE_URL al compilar el frontend, no como env var en
# runtime (el frontend es HTML/JS estático, no lee variables de entorno del
# servidor). Ver DEPLOY.md.
# VITE_API_BASE_URL=https://imtes.sonora.gob.mx/gtfs/api/v1
